# Base URL backend AI Website Generator (boleh origin atau + /api/v1).
# Contoh: http://localhost:8080  atau  http://127.0.0.1:8080/api/v1
VITE_API_BASE_URL=http://localhost:8080

# Mode mock untuk pengembangan UI tanpa backend/Gemini (dev saja).
# Jangan aktifkan di produksi. Skenario: ok | pre502 | err-<REASON> |
# no-terminal | conflict-generating | conflict-revise | ratelimit
# (atau via query ?mock=<skenario>).
# VITE_USE_MOCK=true
# VITE_MOCK_SCENARIO=ok
